NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://korean-selection-store-rebuilt.vercel.app
NEXT_PUBLIC_ADMIN_SITE_URL=https://gyeot-admin.vercel.app
# Optional GA4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional override; otherwise the app derives /functions/v1/checkout from the project URL.
SUPABASE_CHECKOUT_FUNCTION_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Test payments are for local/Preview only; Production should remain false.
TEST_PAYMENT_ENABLED=false
NEXT_PUBLIC_TEST_PAYMENT_ENABLED=false
# ECPay AIO stage is opt-in. Keep false until all callback URLs and secrets
# are configured in Supabase Edge Function secrets.
NEXT_PUBLIC_ECPAY_ENABLED=false
ECPAY_ENABLED=false
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_RETURN_URL=https://abpcgehunhtqrfackqyn.supabase.co/functions/v1/ecpay-callback
ECPAY_PAYMENT_INFO_URL=https://abpcgehunhtqrfackqyn.supabase.co/functions/v1/ecpay-payment-info
ECPAY_CLIENT_BACK_URL=https://korean-selection-store-rebuilt.vercel.app/checkout
ECPAY_ORDER_RESULT_URL=https://korean-selection-store-rebuilt.vercel.app/api/ecpay/result
ECPAY_ENDPOINT=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_CHOOSE_PAYMENT=Credit
